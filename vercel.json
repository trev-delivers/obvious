{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "site",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-7GYCNjBGXrX6Nnk82Qz5kqxFOFXzMBY+2UQSS7tqCQE='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pixel",
      "destination": "https://designedbytrev.com/writing/pixel-rules",
      "permanent": true
    },
    {
      "source": "/pixel/loop",
      "destination": "https://designedbytrev.com/writing/pixel-rules#loop-and-screen",
      "permanent": true
    },
    {
      "source": "/pixel/effects",
      "destination": "https://designedbytrev.com/writing/pixel-rules#effects",
      "permanent": true
    },
    {
      "source": "/pixel/motion",
      "destination": "https://designedbytrev.com/writing/pixel-rules#motion-and-hits",
      "permanent": true
    },
    {
      "source": "/pixel/access",
      "destination": "https://designedbytrev.com/writing/pixel-rules#accessibility",
      "permanent": true
    },
    {
      "source": "/pixel/discord",
      "destination": "https://designedbytrev.com/writing/pixel-rules#discord",
      "permanent": true
    },
    {
      "source": "/pixel/lettering",
      "destination": "https://designedbytrev.com/writing/pixel-rules#lettering",
      "permanent": true
    },
    {
      "source": "/pixel/smuggle-brawlers",
      "destination": "https://designedbytrev.com/writing/smuggle-brawlers",
      "permanent": true
    }
  ]
}
