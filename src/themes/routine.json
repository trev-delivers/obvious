{
  "name": "routine",
  "family": true,
  "description": "Morning & Night. The only theme that moves: its palette is a ramp through the day, interpolated from the clock at runtime, so the app is warm at dawn, bright at noon and properly dark after bedtime. These values are the 10am stop, which is what a page paints before JavaScript has read the time.",
  "dial": { "radius-base": "13px", "density": "1" },
  "font": {
    "display": "'Fraunces', Georgia, serif",
    "sans": "'Inter', system-ui, sans-serif",
    "mono": "'Inter', system-ui, sans-serif",
    "script": "'Fraunces', Georgia, serif"
  },
  "color": {
    "bg": "#FAF7F1",
    "bg-alt": "#F1EDE2",
    "surface": "#FFFFFF",
    "surface-raised": "#FFFFFF",
    "surface-hover": "#F5F1E9",
    "border-subtle": "rgba(30, 27, 46, 0.05)",
    "border": "rgba(30, 27, 46, 0.08)",
    "border-strong": "rgba(30, 27, 46, 0.16)",
    "text": "#1E1B2E",
    "text-dim": "#6B6780",
    "text-muted": "#A5A1B5",
    "text-inverse": "#FFFFFF",
    "accent": "#F0693C",
    "accent-hover": "#E85F32",
    "accent-contrast": "#FFFFFF",
    "accent-alt": "#5A5CE0",
    "accent-gradient": "linear-gradient(135deg, #F0693C 0%, #5A5CE0 100%)",
    "success": "#2E9E6B",
    "warning": "#B07A16",
    "danger": "#D14343",
    "info": "#5A5CE0",
    "shadow-color": "rgba(30, 27, 46, 0.28)",
    "shadow-highlight": "rgba(255, 255, 255, 0.90)",
    "selection-bg": "#F0693C",
    "selection-text": "#FFFFFF"
  }
}
