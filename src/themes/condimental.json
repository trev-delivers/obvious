{
  "name": "condimental",
  "family": true,
  "description": "For Condiment Gallery. Warm paper and brown ink, with a ketchup red and a bit of mustard behind it. It's light like Brookwood but cleaner, and it's the roundest of the lot.",
  "dial": {
    "radius-base": "16px",
    "density": "1"
  },
  "font": {
    "display": "'Young Serif', Georgia, serif",
    "sans": "'Figtree', system-ui, sans-serif",
    "mono": "'Figtree', system-ui, sans-serif",
    "script": "'Figtree', system-ui, sans-serif"
  },
  "color": {
    "bg": "#faf5ee",
    "bg-alt": "#f4ead2",
    "surface": "#ffffff",
    "surface-raised": "#ffffff",
    "surface-hover": "#f5eee2",
    "border-subtle": "rgba(37, 26, 12, 0.08)",
    "border": "rgba(37, 26, 12, 0.08)",
    "border-strong": "rgba(37, 26, 12, 0.16)",
    "text": "#241a10",
    "text-dim": "#4a3a28",
    "text-muted": "#8c8071",
    "text-inverse": "#fff8f0",
    "accent": "#e14e3b",
    "accent-hover": "#c93f2e",
    "accent-contrast": "#fff8f0",
    "accent-alt": "#f5b841",
